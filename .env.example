# Documentation only: jobhub never automatically loads a working-directory .env.
# Prefer jobhub setup hidden prompts for secrets; use exported variables for automation.
# Do not commit populated copies of this file.

# export JOBHUB_HOME=/absolute/path/to/private/jobhub
# export JOBHUB_NOTION_TOKEN=...               # required for noninteractive automation
# export JOBHUB_LMSTUDIO_BASE_URL=http://localhost:1234/v1
# export JOBHUB_MODEL_PRIMARY=your-loaded-chat-model
# export JOBHUB_MODEL_EMBEDDING=your-loaded-embedding-model
# export JOBHUB_LMSTUDIO_API_KEY=...           # only with LM Studio authentication enabled
# export JOBHUB_SMTP_PASSWORD=...             # only if notifications are enabled
# export JOBHUB_IMAP_PASSWORD=...             # only if alert mailbox discovery is enabled
# export JOBHUB_ADZUNA_APP_KEY=...            # only if this source is enabled
# export JOBHUB_USAJOBS_AUTH_KEY=...          # only if this source is enabled
# export JOBHUB_JOOBLE_API_KEY=...            # only if this source is enabled
# export JOBHUB_CAPTURE_AUTH_TOKEN=...        # only if capture is explicitly started

# Search keywords, exclusions, locations, source targets and cadence belong in Notion.
# Do not supply individual database IDs: setup discovers them from the root URL.
